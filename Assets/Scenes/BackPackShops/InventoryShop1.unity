  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0422\u0435\u043F\u0435\u0440\u044C, \u0435\u0441\u043B\u0438 \u043D\u0430\u0432\u0435\u0441\u0442\u0438
    \u043A\u0443\u0440\u0441\u043E\u0440 \u043D\u0430 \u0433\u0440\u0438\u0431 'Chanterelle',
    \u043C\u043E\u0436\u043D\u043E \u0443\u0432\u0438\u0434\u0435\u0442\u044C, \u0447\u0442\u043E
    \u0435\u0433\u043E \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0430 \u0437\u0430\u0433\u043E\u0440\u0435\u043B\u0430\u0441\u044C,
    \u0430 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438
    \u0443\u043C\u0435\u043D\u044C\u0448\u0438\u043B\u0430\u0441\u044C \u043D\u0430
    10%. \u041C\u043E\u0436\u043D\u043E \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C
    \u0435\u0449\u0451 \u0433\u0440\u0438\u0431\u043E\u0432 \u2014 \u043A\u0430\u0436\u0434\u044B\u0439
    \u043D\u043E\u0432\u044B\u0439 \u0434\u0430\u0441\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0435
    \u0441\u043E\u043A\u0440\u0430\u0449\u0435\u043D\u0438\u0435 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0438
    \u043D\u0430 10%!"
  m_isRightToLeft: 0
