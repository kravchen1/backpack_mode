  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0420\u044E\u043A\u0437\u0430\u043A\r\n\u042D\u0442\u043E \u0432\u0430\u0448\u0435
    \u043E\u0441\u043D\u043E\u0432\u043D\u043E\u0435 \u0438\u0433\u0440\u043E\u0432\u043E\u0435
    \u043F\u043E\u043B\u0435. \u0412\u044B \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0435\u0442\u0435
    \u0432 \u043D\u0435\u043C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C\u0441\u044F
    \u0432 \u0431\u043E\u044E.\r\n\u0420\u044E\u043A\u0437\u0430\u043A \u0438\u043C\u0435\u0435\u0442
    \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u044F\u0447\u0435\u0435\u043A, \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u0432\u0430\u0436\u043D\u043E
    \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432.\r\n\r\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B \u0437\u0430\u043D\u0438\u043C\u0430\u044E\u0442
    \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u044F\u0447\u0435\u0435\u043A,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043F\u043B\u0430\u043D\u0438\u0440\u0443\u0439\u0442\u0435
    \u0438\u0445 \u0440\u0430\u0437\u043C\u0435\u0449\u0435\u043D\u0438\u0435 \u0437\u0430\u0440\u0430\u043D\u0435\u0435."
