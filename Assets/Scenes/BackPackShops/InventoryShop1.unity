    - target: {fileID: 963595301515191035, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_text
      value: "\u0421\u0438\u043B\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: DescriptionKey
      value: "\u0421\u0438\u043B\u0430\r\n\u0414\u0435\u0432\u0438\u0437: \"\u0412\u0435\u0441
        \u0440\u0435\u0448\u0430\u0435\u0442. \u041C\u043E\u044F \u0432\u043E\u043B\u044F
        \u2014 \u0437\u0430\u043A\u043E\u043D.\"\r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442:\n\r\n+5%
        \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
        \u043E\u0447\u043A\u043E \u0434\u043B\u044F \u043E\u0440\u0443\u0436\u0438\u044F
        \u0431\u043B\u0438\u0436\u043D\u0435\u0433\u043E \u0431\u043E\u044F.\r\n\r\n\u0421\u043C\u0435\u0449\u0430\u0435\u0442
        \u043F\u043E\u0440\u043E\u0433\u0438 \u0432\u0435\u0441\u0430 \u043D\u0430
        +2 \u0437\u0430 \u043E\u0447\u043A\u043E.\r\r\n\r\n\u0421\u0438\u0441\u0442\u0435\u043C\u0430
        \u0432\u0435\u0441\u0430:\n\r\n\u0421\u043B\u0430\u0431\u0430\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430
        (< 40): \u0428\u0442\u0440\u0430\u0444\u043E\u0432 \u043D\u0435\u0442.\n\r\n\u041D\u0430\u0433\u0440\u0443\u0437\u043A\u0430
        (40-60): \u041F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
        \u0441\u0442\u0430\u043C\u0438\u043D\u044B \u0434\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438
        \u041B\u042E\u0411\u041E\u0413\u041E \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
        +25%.\n\r\n\u0412\u044B\u0441\u043E\u043A\u0430\u044F \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u0430
        (60-80): \u041F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
        \u0441\u0442\u0430\u043C\u0438\u043D\u044B +50%.\n\n\u041F\u0435\u0440\u0435\u0433\u0440\u0443\u0437
        (>80): \u041F\u043E\u0442\u0440\u0435\u0431\u043B\u0435\u043D\u0438\u0435
        \u0441\u0442\u0430\u043C\u0438\u043D\u044B +100%, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
        \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
        \u0441\u043D\u0438\u0436\u0435\u043D\u0430."
      objectReference: {fileID: 0}
