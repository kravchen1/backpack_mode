      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 963595301515191035, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_text
      value: "\u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442"
      objectReference: {fileID: 0}
    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: DescriptionKey
      value: "\u0418\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442\r\n\u0414\u0435\u0432\u0438\u0437:
        \"\u041F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u0441\u0442\u0432\u043E
        \u0447\u0435\u0440\u0435\u0437 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435.\"\r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442:\r\n\r\n+5%
        \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
        \u043E\u0447\u043A\u043E \u043A \u043F\u0441\u0438-\u0438\u043B\u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u043C\u0443
        \u043E\u0440\u0443\u0436\u0438\u044E (\u043D\u0435\u0439\u0440\u043E-\u0432\u0438\u0440\u0443\u0441\u044B,
        \u0434\u0440\u043E\u043D\u044B-\u0430\u0441\u0441\u0430\u0441\u0438\u043D\u044B,
        \u043E\u0440\u0443\u0436\u0438\u0435 \u043D\u0430 \u043D\u043E\u0432\u044B\u0445
        \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0445 \u043F\u0440\u0438\u043D\u0446\u0438\u043F\u0430\u0445).\r\n\r\n\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
        \u0434\u043B\u044F \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
        \u0441\u043E \u0441\u043B\u043E\u0436\u043D\u044B\u043C\u0438 \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430\u043C\u0438:
        \u0432\u0437\u043B\u043E\u043C \u0437\u0430\u043C\u043A\u043E\u0432, \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0430
        \u0441\u0438\u0441\u0442\u0435\u043C, \u043F\u0435\u0440\u0435\u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u0435."
      objectReference: {fileID: 0}
    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: textDescriptionsCharacterStats
      value: 
