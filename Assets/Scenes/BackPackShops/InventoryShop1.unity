  m_text: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u043A\u0443\u043F\u0438\u043C
    \u0433\u0440\u0438\u0431 \"Chanterelle\". \u0414\u043B\u044F \u044D\u0442\u043E\u0433\u043E
    \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
    \u0438\u0437 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430, \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0443\u043A\u0430\u0437\u044B\u0432\u0435\u0442 \u0437\u0435\u043B\u0435\u043D\u0430\u044F
    \u0441\u0442\u0440\u0435\u043B\u043A\u0430. \u041D\u0430 \u0435\u0433\u043E \u043F\u0440\u0438\u043C\u0435\u0440\u0435
    \u043C\u044B \u0443\u0432\u0438\u0434\u0438\u043C \u0432\u0435\u0441\u044C \u043F\u043E\u0442\u0435\u043D\u0446\u0438\u0430\u043B
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430."
