  m_text: "\u0411\u043E\u0438\r\n\u0411\u043E\u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0442
    \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438.
    \u0412\u044B \u0438 \u0432\u0430\u0448 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0438\u0437 \u0441\u0432\u043E\u0438\u0445 \u0440\u044E\u043A\u0437\u0430\u043A\u043E\u0432,
    \u0447\u0442\u043E\u0431\u044B \u043D\u0430\u043D\u043E\u0441\u0438\u0442\u044C
    \u0443\u0440\u043E\u043D \u0438 \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C\u0441\u044F.\r\n\r\n\u041F\u043E\u0431\u0435\u0436\u0434\u0430\u0435\u0442
    \u0442\u043E\u0442, \u043A\u0442\u043E \u043F\u0435\u0440\u0432\u044B\u043C \u0438\u0441\u0442\u043E\u0449\u0438\u0442
    \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u0430."
