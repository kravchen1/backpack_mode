  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u041D\u0435\u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
    \u0432 \u0438\u0433\u0440\u0435 \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442
    \u043E\u0441\u043E\u0431\u044B\u043C\u0438 \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0430\u043C\u0438,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u044B
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0438\u0445 \u0438\u043A\u043E\u043D\u043A\u0438.
    \u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u0435\u043A
    \u043C\u043E\u0436\u0435\u0442 \u0431\u044B\u0442\u044C \u0440\u0430\u0437\u043D\u044B\u043C
    \u2014 \u043E\u0442 \u043E\u0434\u043D\u043E\u0439 \u0434\u043E \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u0438\u0445.\n\u041A\u0430\u0436\u0434\u0430\u044F
    \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0451\u043D\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
    \u0434\u043B\u044F \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438. \u0427\u0442\u043E\u0431\u044B
    \u0435\u0451 \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u0442\u044C:\r\n\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435
    \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u0430
    \u2014 \u0442\u0430\u043C \u0443\u043A\u0430\u0437\u0430\u043D\u043E, \u0447\u0442\u043E
    \u043D\u0443\u0436\u043D\u043E \u0434\u043B\u044F \u043A\u0430\u0436\u0434\u043E\u0439
    \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0438.\r\n\u041F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435
    \u043D\u0443\u0436\u043D\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
    \u0432  \u044F\u0447\u0435\u0439\u043A\u0443 \u0440\u044E\u043A\u0437\u0430\u043A\u0430
    \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043E\u043D \u0437\u0430\u043F\u043E\u043B\u043D\u0438\u043B
    \u043F\u0443\u0441\u0442\u0443\u044E \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0443.\r\n\u0415\u0441\u043B\u0438
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u043F\u043E\u0434\u0445\u043E\u0434\u0438\u0442
    \u2014 \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0430 \u0437\u0430\u0433\u043E\u0440\u0438\u0442\u0441\u044F,
    \u0438 \u044D\u0444\u0444\u0435\u043A\u0442 \u0430\u043A\u0442\u0438\u0432\u0438\u0440\u0443\u0435\u0442\u0441\u044F!"
