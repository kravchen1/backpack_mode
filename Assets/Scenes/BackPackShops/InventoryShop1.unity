  m_text: "\u041C\u0430\u0433\u0430\u0437\u0438\u043D\n\u0417\u0434\u0435\u0441\u044C
    \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u043A\u0443\u043F\u0438\u0442\u044C
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B. \u0421\u043B\u0435\u0434\u0438\u0442\u0435
    \u0437\u0430 \u0435\u0433\u043E \u0441\u0442\u043E\u0438\u043C\u043E\u0441\u0442\u044C\u044E
    \u0438 \u043D\u0435 \u0437\u0430\u0431\u0443\u0434\u044C\u0442\u0435 \u0438\u0437\u0443\u0447\u0442\u044C
    \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u043C\u044B\u0439 \u043F\u0440\u0435\u0434\u043C\u0435\u0442,
    \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0430 \u043B\u044E\u0431\u043E\u0439
    \u043F\u0440\u0435\u0434\u043C\u0435\u0442 \u0438 \u043F\u043E\u0447\u0438\u0442\u0430\u0439\u0442\u0435
    \u0447\u0442\u043E \u043E\u043D \u0434\u0435\u043B\u0430\u0435\u0442. \u0415\u0441\u043B\u0438
    \u0432\u0430\u043C \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0437\u043E\u043B\u043E\u0442\u0430,
    \u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0430\u0436\u043C\u0438\u0442\u0435
    \u0438 \u043F\u0435\u0440\u0435\u0442\u0430\u0449\u0438\u0442\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442
    \u0432 \u0441\u0432\u043E\u0439 \u0440\u044E\u043A\u0437\u0430\u043A"
