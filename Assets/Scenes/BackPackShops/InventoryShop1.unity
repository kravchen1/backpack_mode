  m_text: "\u0426\u0435\u043B\u044C \u0438\u0433\u0440\u044B \u2014 \u0441\u043E\u0431\u0440\u0430\u0442\u044C
    \u043B\u0443\u0447\u0448\u0438\u0439 \u043D\u0430\u0431\u043E\u0440 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
    \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435, \u0447\u0442\u043E\u0431\u044B
    \u043F\u043E\u0431\u0435\u0436\u0434\u0430\u0442\u044C \u043F\u0440\u043E\u0442\u0438\u0432\u043D\u0438\u043A\u043E\u0432
    \u0432 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0431\u043E\u044F\u0445. \u0412\u044B \u0434\u043E\u043B\u0436\u043D\u044B \u0441\u0442\u0440\u0430\u0442\u0435\u0433\u0438\u0447\u0435\u0441\u043A\u0438
    \u0440\u0430\u0437\u043C\u0435\u0449\u0430\u0442\u044C \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B,
    \u043A\u043E\u043C\u0431\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0438\u0445 \u044D\u0444\u0444\u0435\u043A\u0442\u044B \u0438 \u0443\u043B\u0443\u0447\u0448\u0430\u0442\u044C
    \u0438\u0445, \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u0442\u044C \u0441\u0438\u043B\u044C\u043D\u0435\u0435."
