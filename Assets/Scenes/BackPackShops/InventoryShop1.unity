--- !u!1001 &222839598
PrefabInstance:
  m_ObjectHideFlags: 0
  serializedVersion: 2
  m_Modification:
    serializedVersion: 3
    m_TransformParent: {fileID: 561177536}
    m_Modifications:
    - target: {fileID: 636306677419543523, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 797630345383147206, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 963595301515191035, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_text
      value: "\u041B\u043E\u0432\u043A\u043E\u0441\u0442\u044C"
      objectReference: {fileID: 0}
    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: DescriptionKey
      value: "\u041B\u043E\u0432\u043A\u043E\u0441\u0442\u044C\n\u0414\u0435\u0432\u0438\u0437:
        \"\u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
        \u043F\u0440\u0435\u0432\u044B\u0448\u0435 \u043C\u0430\u0441\u0441\u044B.\"\r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442:\r\n\r\n+5%
        \u0443\u0440\u043E\u043D\u0430 \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
        \u043E\u0447\u043A\u043E \u043A \u0441\u0442\u0440\u0435\u043B\u043A\u043E\u0432\u043E\u043C\u0443
        \u043E\u0440\u0443\u0436\u0438\u044E (\u043F\u0438\u0441\u0442\u043E\u043B\u0435\u0442\u044B,
        \u0432\u0438\u043D\u0442\u043E\u0432\u043A\u0438, \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0435
        \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u0435\u043B\u0438).\r\n\r\n+1%
        \u0448\u0430\u043D\u0441 \u0443\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u044F
        \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u043E\u0447\u043A\u043E
        (\u043C\u0430\u043A\u0441. 90%). \u0423\u043A\u043B\u043E\u043D\u0435\u043D\u0438\u0435
        \u0442\u0440\u0430\u043A\u0442\u0443\u0435\u0442\u0441\u044F \u043A\u0430\u043A
        \"\u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438
        \u0443\u0432\u043E\u0434\u0438\u0442 \u0432\u0430\u0441 \u0438\u0437-\u043F\u043E\u0434
        \u0443\u0434\u0430\u0440\u0430\"."
      objectReference: {fileID: 0}
    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: textDescriptionsCharacterStats
      value: 
      objectReference: {fileID: 1970355049}
