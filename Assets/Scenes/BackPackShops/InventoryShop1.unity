    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: DescriptionKey
      value: "\u0412\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C\r\n\u0414\u0435\u0432\u0438\u0437:
        \"\u0417\u0430\u043F\u0430\u0441 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438
        \u2014 \u0437\u0430\u043F\u0430\u0441 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0435\u0439.\"\r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442:
        \n\n+1 \u043A \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439
        \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438
        \u0432 \u043D\u0430\u0447\u0430\u043B\u0435 \u0431\u043E\u044F \u0437\u0430
        \u043A\u0430\u0436\u0434\u043E\u0435 \u043E\u0447\u043A\u043E.\n\n+10 \u043A
        \u043C\u0430\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u043C\u0443
        \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044E  \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435
        \u043E\u0447\u043A\u043E\r\n\r\n\u0413\u0435\u0439\u043C\u043F\u043B\u0435\u0439:
        \u0412\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u044C
        \u2014 \u044D\u0442\u043E \u0440\u0435\u0441\u0443\u0440\u0441 \u0434\u043B\u044F
        \u0430\u043A\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u0432
        \u0432 \u0438\u043D\u0432\u0435\u043D\u0442\u0430\u0440\u0435 (\u043E\u0440\u0443\u0436\u0438\u0435,
        \u0449\u0438\u0442\u044B, \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B).
        \u0411\u043E\u043B\u044C\u0448\u0435 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u043E\u0441\u0442\u0438
        \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0430\u0437 \u0432\u044B
        \u043C\u043E\u0436\u0435\u0442\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
        \u043C\u043E\u0449\u043D\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B."
      objectReference: {fileID: 0}
