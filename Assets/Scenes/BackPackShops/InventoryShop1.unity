    - target: {fileID: 797630345383147206, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_IsActive
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 963595301515191035, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: m_text
      value: "\u0425\u0430\u0440\u0438\u0437\u043C\u0430"
      objectReference: {fileID: 0}
    - target: {fileID: 2521827904141656219, guid: eb29273d6cb2aee47aec7be195b13280, type: 3}
      propertyPath: DescriptionKey
      value: "\u0425\u0430\u0440\u0438\u0437\u043C\u0430\r\n\u0414\u0435\u0432\u0438\u0437:
        \"\u0423\u0432\u0435\u0440\u0435\u043D\u043D\u043E\u0441\u0442\u044C \u2014
        \u043B\u0443\u0447\u0448\u0438\u0439 \u0430\u0440\u0433\u0443\u043C\u0435\u043D\u0442.\"\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442:\n\r\n\u0426\u0435\u043D\u044B
        \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0430\u0445 \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F
        \u043D\u0430 3% \u0432 \u0432\u0430\u0448\u0443 \u043F\u043E\u043B\u044C\u0437\u0443
        \u0437\u0430 \u043A\u0430\u0436\u0434\u043E\u0435 \u043E\u0447\u043A\u043E.\r\n\r\n\u0421\u0418\u0421\u0422\u0415\u041C\u0410
        \u041E\u0422\u041D\u041E\u0428\u0415\u041D\u0418\u0419 \u041D\u041F\u0421:\r\n\u041D\u041F\u0421
        \u043E\u0446\u0435\u043D\u0438\u0432\u0430\u044E\u0442 \u0432\u0430\u0448\u0443
        \u0445\u0430\u0440\u0438\u0437\u043C\u0443. \u0423 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
        \u043C\u043E\u043D\u0441\u0442\u0440\u0430 \u0435\u0441\u0442\u044C \u043F\u043E\u0440\u043E\u0433
        \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438
        \u0438 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u043E\u0441\u0442\u0438.
        \n\n\u0415\u0441\u043B\u0438 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
        \u0432\u0430\u0448\u0435\u0439 \u0445\u0430\u0440\u0438\u0437\u043C\u044B
        \u0431\u0443\u0434\u0435\u0442 \u043D\u0438\u0436\u0435 \u043F\u043E\u0440\u043E\u0433\u0430
        \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u043D\u043E\u0441\u0442\u0438,
        \u043D\u043F\u0441 \u0431\u0443\u0434\u0435\u0442 \u0430\u0433\u0440\u0435\u0441\u0441\u0438\u0432\u0435\u043D
        \u043A \u0432\u0430\u043C\n\n\r\u0415\u0441\u043B\u0438 \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435
        \u0432\u0430\u0448\u0435\u0439 \u0445\u0430\u0440\u0438\u0437\u043C\u044B
        \u0431\u0443\u0434\u0435\u0442 \u0432\u044B\u0448\u0435 \u043F\u043E\u0440\u043E\u0433\u0430
        \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u043D\u043E\u0441\u0442\u0438,
        \u043D\u043F\u0441 \u0431\u0443\u0434\u0435\u0442 \u0434\u0440\u0443\u0436\u0435\u043B\u044E\u0431\u0435\u043D
        \u043A \u0432\u0430\u043C\n\n\u0415\u0441\u043B\u0438 \u0436\u0435 \u043F\u043E
        \u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435, \u0442\u043E \u043D\u0435\u0439\u0442\u0440\u0430\u043B\u0435\u043D"
      objectReference: {fileID: 0}
