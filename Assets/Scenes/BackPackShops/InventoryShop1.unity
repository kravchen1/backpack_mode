  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u0430\u0432\u0430\u0439\u0442\u0435 \u0440\u0430\u0437\u0431\u0435\u0440\u0451\u043C,
    \u043A\u0430\u043A \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442 \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0438,
    \u043D\u0430 \u043F\u0440\u0438\u043C\u0435\u0440\u0435 \u0433\u0440\u0438\u0431\u043E\u0432.\n\u0423
    \u0432\u0430\u0441 \u0432 \u0440\u044E\u043A\u0437\u0430\u043A\u0435 \u043B\u0435\u0436\u0438\u0442
    \u0433\u0440\u0438\u0431 \"\u041B\u0438\u0441\u0438\u0447\u043A\u0430\". \u0412
    \u0435\u0433\u043E \u043E\u043F\u0438\u0441\u0430\u043D\u0438\u0438 \u0443\u043A\u0430\u0437\u0430\u043D\u043E:\n\u0437\u0430
    \u043A\u0430\u0436\u0434\u044B\u0439 \u0433\u0440\u0438\u0431 \u043F\u043E\u0434
    \u0437\u0432\u0435\u0437\u0434\u043E\u0439 \u043F\u0435\u0440\u0435\u0437\u0430\u0440\u044F\u0434\u043A\u0430
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438 \u0443\u043C\u0435\u043D\u044C\u0448\u0430\u0435\u0442\u0441\u044F
    \u043D\u0430 10%\n\u042D\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442, \u0435\u0441\u043B\u0438
    \u043F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u043B\u044E\u0431\u043E\u0439
    \u0434\u0440\u0443\u0433\u043E\u0439 \u0433\u0440\u0438\u0431 \u0432 \u044D\u0442\u0443
    \u0437\u0432\u0451\u0437\u0434\u043E\u0447\u043A\u0443, \"Chanterelle\" \u0441\u0442\u0430\u043D\u0435\u0442
    \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C \u0431\u044B\u0441\u0442\u0440\u0435\u0435!"
